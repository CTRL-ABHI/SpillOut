// Prisma PostgreSQL schema for production / Docker deployments

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  Male
  Female
  Object
}

model User {
  id                String    @id @default(uuid())
  username          String    @db.VarChar(10)
  canonicalUsername String    @unique @db.VarChar(10)
  passwordHash      String
  gender            Gender
  avatarId          String?   @db.VarChar(32) // Profile avatar identifier (e.g. avatar_01)
  publicKey         String?   // Base64-encoded public cryptographic identity key
  createdAt         DateTime  @default(now())
  lastActivityAt    DateTime  @default(now())
  sessions          Session[]

  @@index([canonicalUsername])
  @@index([lastActivityAt])
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([token])
  @@index([userId])
}

model Message {
  id                        String    @id
  conversationId            String
  senderCanonical           String
  recipientCanonical        String
  ciphertext                String
  iv                        String
  tag                       String?
  senderEphemeralPublicKey  String
  createdAt                 DateTime  @default(now())
  expiresAt                 DateTime
  status                    String    @default("sent")
  deliveredAt               DateTime?

  @@index([recipientCanonical, expiresAt])
  @@index([conversationId, expiresAt])
  @@index([expiresAt])
  @@index([senderCanonical, createdAt])
}

model Conversation {
  id                    String    @id
  participant1Canonical String    @db.VarChar(10)
  participant2Canonical String    @db.VarChar(10)
  createdAt             DateTime  @default(now())
  lastInteractionAt     DateTime  @default(now())

  @@unique([participant1Canonical, participant2Canonical])
  @@index([participant1Canonical, lastInteractionAt])
  @@index([participant2Canonical, lastInteractionAt])
  @@index([lastInteractionAt])
}
