// Prisma PostgreSQL schema for production / Docker deployments

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  Male
  Female
  Object
}

model User {
  id                String    @id @default(uuid())
  username          String    @db.VarChar(10)
  canonicalUsername String    @unique @db.VarChar(10)
  passwordHash      String
  gender            Gender
  publicKey         String?   // Base64-encoded public cryptographic identity key
  createdAt         DateTime  @default(now())
  lastActivityAt    DateTime  @default(now())
  sessions          Session[]

  @@index([canonicalUsername])
  @@index([lastActivityAt])
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([token])
  @@index([userId])
}
