# Server Environment Configuration
PORT=4000
NODE_ENV=development
DATABASE_URL="file:./dev.db"
# For PostgreSQL: DATABASE_URL="postgresql://spillout:spillout_secret@localhost:5432/spillout?schema=public"
CLIENT_ORIGIN="http://localhost:3000"
COOKIE_SECRET="spillout_super_secret_cookie_key_replace_in_production_32chars"
SESSION_TTL_HOURS=168 # 7 days
INACTIVITY_EXPIRATION_DAYS=7
INACTIVITY_CHECK_INTERVAL_MS=3600000 # 1 hour
# Optional Redis for multi-instance temporary presence and distributed pub/sub
# REDIS_URL="redis://localhost:6379"
