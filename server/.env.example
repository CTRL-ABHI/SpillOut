# Server Environment Configuration (Render / Docker / VPS)
PORT=4000
NODE_ENV=production

# Database Connection (Neon PostgreSQL in production / SQLite dev default)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# For local development zero-setup: DATABASE_URL="file:./dev.db"

# Origin of deployed frontend on Vercel
CLIENT_ORIGIN="https://your-spillout-app.vercel.app"

# Session Cookie Signing Secret (minimum 32 characters)
COOKIE_SECRET="spillout_production_cookie_secret_key_32_characters_minimum"

# Inactivity and session lifetimes
SESSION_TTL_HOURS=168
INACTIVITY_EXPIRATION_DAYS=7
INACTIVITY_CHECK_INTERVAL_MS=3600000

# Optional: enable cross-site cookies if running cross-origin without Next.js proxy
# ALLOW_CROSS_SITE_COOKIES=false

# Optional Redis for multi-instance temporary presence (no persistence)
# REDIS_URL="redis://localhost:6379"
