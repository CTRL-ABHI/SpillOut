# Frontend Vercel Environment Configuration

# Production backend API URL (used by Next.js rewrites to proxy /api/* server-to-server)
BACKEND_API_URL="https://your-backend-service.onrender.com/api"

# Production WebSocket endpoint (used directly by browser client for real-time E2EE messaging and WebRTC signaling)
NEXT_PUBLIC_WS_URL="wss://your-backend-service.onrender.com/ws"

# Optional: Browser direct API URL override
# NEXT_PUBLIC_API_URL="https://your-backend-service.onrender.com/api"

# Optional: WebRTC STUN/TURN Configuration (Defaults to Google public STUN servers)
# NEXT_PUBLIC_STUN_URL="stun:stun1.l.google.com:19302"
# NEXT_PUBLIC_TURN_URL="turn:your-turn-server.com:3478"
# NEXT_PUBLIC_TURN_USERNAME="turn-username"
# NEXT_PUBLIC_TURN_CREDENTIAL="turn-password"
