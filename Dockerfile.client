# Production multi-stage Dockerfile for SPILLOUT Next.js client
FROM node:22-alpine AS builder

WORKDIR /app

COPY client/package*.json ./
RUN npm ci

COPY client/tsconfig.json client/tailwind.config.ts client/postcss.config.mjs client/next.config.mjs ./
COPY client/src ./src/

ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# Runner stage
FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

COPY client/package*.json ./
RUN npm ci --omit=dev

COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY client/next.config.mjs ./

EXPOSE 3000

CMD ["npm", "run", "start"]
