# SPILLOUT Root Environment Configuration

# Server configuration
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:3000"
COOKIE_SECRET="spillout_super_secret_cookie_key_replace_in_production_32chars"
SESSION_TTL_HOURS=168
INACTIVITY_EXPIRATION_DAYS=7
INACTIVITY_CHECK_INTERVAL_MS=3600000

# Database URLs:
# Local development zero-setup default:
DATABASE_URL="file:./dev.db"
# PostgreSQL production:
# DATABASE_URL="postgresql://spillout:spillout_production_secret_change_me@localhost:5432/spillout?schema=public"

# Optional Redis for distributed temporary presence (no persistence)
# REDIS_URL="redis://localhost:6379"

# Frontend configuration
BACKEND_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_WS_URL="ws://localhost:4000/ws"
