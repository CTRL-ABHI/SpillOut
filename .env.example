# ==============================================================================
# SPILLOUT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy appropriate sections to your deployment platforms (Render and Vercel).
# NEVER commit production passwords, live tokens, or private secrets to git.

# ------------------------------------------------------------------------------
# 1. BACKEND SERVICE CONFIGURATION (Render / Docker / VPS)
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=production

# Hosted PostgreSQL connection string (from Neon.tech or Supabase)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Origin of the deployed Vercel frontend (for CORS validation)
CLIENT_ORIGIN="https://your-spillout-app.vercel.app"

# Cryptographically random signing key for session cookies (minimum 32 characters)
COOKIE_SECRET="replace_with_random_32_characters_string_in_production"

# Inactivity and session lifetimes (hours/days)
SESSION_TTL_HOURS=168
INACTIVITY_EXPIRATION_DAYS=7
INACTIVITY_CHECK_INTERVAL_MS=3600000

# Optional: enable cross-site cookies if frontend and backend use different domains without Next.js proxy
# ALLOW_CROSS_SITE_COOKIES=false

# Optional: Ephemeral Redis URL for multi-instance presence coordination (no disk persistence)
# REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 2. FRONTEND APPLICATION CONFIGURATION (Vercel)
# ------------------------------------------------------------------------------
# Production backend API URL (used by Next.js server-side rewrites to proxy /api/*)
BACKEND_API_URL="https://your-backend-service.onrender.com/api"

# Production WebSocket endpoint (used directly by browser client for E2EE chat & voice calls)
NEXT_PUBLIC_WS_URL="wss://your-backend-service.onrender.com/ws"

# Optional: Direct browser API URL fallback (only if bypassing Next.js proxy rewrites)
# NEXT_PUBLIC_API_URL="https://your-backend-service.onrender.com/api"
